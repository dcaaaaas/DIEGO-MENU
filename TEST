    local function applyBigHead(pl, char)
        if pl==LP or not char then return end
        pcall(function()
            local head = char:FindFirstChild("Head")
            if head then
                local targetSz = Vector3.new(BH.Size, BH.Size, BH.Size)
                if head.Size ~= targetSz then head.Size = targetSz end
                if head.Transparency ~= BH.Transparency then head.Transparency = BH.Transparency end
                if head.BrickColor ~= BrickColor.new("Red") then head.BrickColor = BrickColor.new("Red") end
                if head.Material ~= Enum.Material.Neon then head.Material = Enum.Material.Neon end
                if head.CanCollide then head.CanCollide = false end
                if not head.Massless then head.Massless = true end
            end
            if BH.Parts.Torso then
                for _, pName in ipairs(PART_NAMES.Torso) do
                    local p = char:FindFirstChild(pName)
                    if p and p:IsA("BasePart") then
                        p.Size = Vector3.new(BH.Size, BH.Size, BH.Size)
                        p.Transparency = BH.Transparency
                        p.CanCollide = false; p.Massless = true
                    end
                end
            end
            for _, limb in ipairs({"RightArm","LeftArm","RightLeg","LeftLeg"}) do
                if BH.Parts[limb] then
                    for _, pName in ipairs(PART_NAMES[limb]) do
                        local p = char:FindFirstChild(pName)
                        if p and p:IsA("BasePart") then
                            p.Size = Vector3.new(BH.Size, BH.Size, BH.Size)
                            p.Transparency = BH.Transparency
                            p.CanCollide = false; p.Massless = true
                        end
                    end
                end
            end
        end)
    end
