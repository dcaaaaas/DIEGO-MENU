                            for _, pName in ipairs(partList) do
                                local part = char:FindFirstChild(pName)
                                if part and part:IsA("BasePart") then
                                    local orig = BH_OriginalSizes[pl] and BH_OriginalSizes[pl][pName]
                                    if orig then
                                        local diff = (part.Size - orig.Size).Magnitude
                                        if diff > 0.05 then
                                            part.Size = part.Size:Lerp(orig.Size, 0.4)
                                        else
                                            part.Size = orig.Size
                                        end
                                        if part.Transparency ~= orig.Trans then part.Transparency = orig.Trans end
                                        if part.Material ~= orig.Mat then part.Material = orig.Mat end
                                        if part.BrickColor ~= orig.BC then part.BrickColor = orig.BC end
                                        if part.CanCollide ~= orig.CC then part.CanCollide = orig.CC end
